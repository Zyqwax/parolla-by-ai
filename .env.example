# AI Provider Configuration
# Choose active provider: "openrouter" | "gemini" | "groq"
VITE_AI_PROVIDER=openrouter
VITE_AI_MODEL=openai/gpt-6-luna

# AI Provider API Keys
# Get OpenRouter key from: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Get Gemini key from: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Get Groq key from: https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here
